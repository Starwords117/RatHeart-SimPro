{
  "appId": "org.ratheartsimpro.teaching",
  "productName": "RatHeart-SimPro",
  "directories": {
    "output": "release"
  },
  "asar": true,
  "npmRebuild": false,
  "files": [
    "desktop/**/*.cjs",
    "server/**/*.cjs",
    "dist/*.html",
    "dist/*.js",
    "dist/*.css",
    "dist/*.webmanifest",
    "dist/*.png",
    "dist/icons/*.png",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "RatHeart-SimPro"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Education",
    "executableName": "ratheart-simpro"
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.education",
    "identity": null
  },
  "portable": {
    "artifactName": "RatHeart-SimPro-${version}-${arch}-Portable.exe"
  },
  "nsis": {
    "artifactName": "RatHeart-SimPro-${version}-${arch}-Setup.exe",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "大鼠心血管实验台",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": [
      "zh_CN"
    ],
    "language": "2052"
  },
  "appImage": {
    "artifactName": "RatHeart-SimPro-${version}-${arch}-AppImage"
  },
  "deb": {
    "artifactName": "ratheart-simpro_${version}_${arch}.deb",
    "packageCategory": "education",
    "maintainer": "Pharmacology Teaching Group <ratcvs@example.edu>"
  },
  "dmg": {
    "artifactName": "RatHeart-SimPro-${version}-${arch}.dmg",
    "title": "RatCVS 中文大鼠心血管实验台"
  }
}