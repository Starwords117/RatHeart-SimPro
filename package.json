{
  "name": "ratheart-simpro",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "RatHeart-SimPro 中文大鼠心血管实验台 — TypeScript Web 重构",
  "author": "Pharmacology Teaching Group <ratcvs@example.edu>",
  "homepage": "https://github.com/Starwords117/RatHeart-SimPro",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/core-checks.mjs && node tests/worker-check.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "npm start",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "pack:installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  }
}
