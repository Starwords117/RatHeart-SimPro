{
  "name": "ratheart-simpro",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "RatHeart-SimPro 中文大鼠心血管实验台 — TypeScript Web 重构",
  "author": "Pharmacology Teaching Group <ratcvs@example.edu>",
  "homepage": "https://github.com/Starwords117/RatHeart-SimPro",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/core-checks.mjs && node tests/worker-check.mjs && node tests/broadcast-e2e.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "npm start",
    "desktop": "npm run build && tauri dev",
    "desktop:build": "npm run build && tauri build",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test:ui": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.5",
    "typescript": "^7.0.2"
  }
}
